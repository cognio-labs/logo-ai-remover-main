# Frontend Environment Variables

# Backend API Origin
# In local development: leave empty to route through the Vite proxy (http://127.0.0.1:8000)
# In production (Vercel): set to your deployed FastAPI backend URL (e.g. https://api.bellix.us or https://<app>.up.railway.app)
VITE_API_URL=

# Optional fine-grained backend overrides (defaults to VITE_API_URL)
# VITE_VIDEO_API_URL=
# VITE_IMAGE_API_URL=

# Optional: Supabase Authentication / Database
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
