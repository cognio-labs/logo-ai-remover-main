# Frontend Environment Variables

# Backend API Origin
# In local development: leave empty to route through the Vite proxy (http://127.0.0.1:8000)
# In production (Vercel): set to your deployed FastAPI backend URL (e.g. https://api.bellix.us or https://<app>.up.railway.app)
VITE_API_URL=

# Optional fine-grained backend overrides (defaults to VITE_API_URL)
# VITE_VIDEO_API_URL=
# VITE_IMAGE_API_URL=

# Optional: Supabase Authentication / Database
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# DataFast Bot traffic (server-side only; do not use a NEXT_PUBLIC_ prefix)
# Create/find this in DataFast's website settings. Required to enable tracking.
DATAFAST_WEBSITE_ID=dfid_your_tracking_id
# Optional. Create this in Bot traffic settings before enabling request-auth enforcement.
# DATAFAST_BOT_TOKEN=dfbot_your_bot_traffic_token
# Dedicated FastAPI worker origin. Required for deployed video cleanup.
# Production must use the public HTTPS worker origin (for example,
# https://video-worker.example.com). Local development may use localhost.
VIDEO_WORKER_URL=http://localhost:8000
